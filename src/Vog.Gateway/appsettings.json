{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "Microsoft.AspNetCore.Http.Connections": "Information"
    }
  },
  "AllowedHosts": "*",
  "Broadcast": {
    "Seed": 3,
    "Speed": 60.0,
    "BreakSeconds": 0,
    "Channels": [
      "en-GB:AudioDescription",
      "en-GB:Commentary",
      "en-GB:Calm",
      "es-ES:AudioDescription",
      "es-ES:Commentary",
      "es-ES:Calm",
      "ta-IN:AudioDescription",
      "ta-IN:Commentary",
      "ta-IN:Calm"
    ]
  }
}
